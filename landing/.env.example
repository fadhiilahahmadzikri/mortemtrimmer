# Cloudflare API Token with scoped permission: Account -> Cloudflare Pages -> Edit
# Create at: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token -> Custom token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
# Found in dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>/... or Workers & Pages sidebar
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
